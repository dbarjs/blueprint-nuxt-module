{
  "$schema": "../playground/.nuxt/blueprint/schema.json",
  "spec": "0.1",
  "name": "hello-world",
  "content": {
    "meta": {
      "title": "Hello, Blueprint",
      "description": "The smallest possible application: one page, one definition, one action.",
      "icon": "i-lucide-hand",
      "currency": "USD",
      "locale": "en-US",
      "theme": { "primary": "emerald", "neutral": "zinc" }
    },
    "resources": {
      "greetings": {
        "type": "list",
        "data": ["Hello", "Olá", "Bonjour", "Hallo", "Ciao"]
      }
    },
    "schemas": {},
    "state": { "index": 0, "name": "" },
    "definitions": {
      "greeting": {
        "type": "string",
        "logic": { "get": [{ "resource": "greetings" }, { "state": "index" }] }
      },
      "message": {
        "type": "string",
        "logic": { "cat": [{ "def": "greeting" }, ", ", { "if": [{ "isEmpty": [{ "state": "name" }] }, "stranger", { "state": "name" }] }, "!"] }
      }
    },
    "actions": {
      "next-greeting": {
        "type": "set",
        "path": "index",
        "value": { "%": [{ "+": [{ "state": "index" }, 1] }, { "length": [{ "resource": "greetings" }] }] }
      }
    },
    "templates": {
      "page:index": {
        "route": "/",
        "title": "Hello",
        "children": [
          {
            "type": "component",
            "as": "Container",
            "children": [
              {
                "type": "component",
                "as": "Stack",
                "props": { "gap": "lg", "paddingY": "xl", "align": "center" },
                "children": [
                  { "type": "component", "as": "Heading", "props": { "level": 1, "align": "center" }, "bind": { "content": { "def": "message" } } },
                  { "type": "component", "as": "Input", "props": { "placeholder": "Your name", "size": "xl", "icon": "i-lucide-user" }, "model": "name" },
                  { "type": "component", "as": "Button", "props": { "label": "Another language", "icon": "i-lucide-languages", "size": "lg" }, "on": { "click": "next-greeting" } },
                  { "type": "component", "as": "Text", "props": { "size": "sm", "color": "muted", "align": "center" }, "content": "This page is content/hello-world.json — edit it and watch it update." }
                ]
              }
            ]
          }
        ]
      }
    },
    "tests": [
      { "name": "default greeting", "expect": { "greeting": "Hello", "message": "Hello, stranger!" } },
      { "name": "greets by name in another language", "state": { "index": 1, "name": "Eduardo" }, "expect": { "message": "Olá, Eduardo!" } },
      {
        "name": "the page greets by name and offers another language",
        "description": "Tree test (ADR 0011): the abstract tree is data; a runtime is conformant when it renders this tree.",
        "state": {"name": "Ada", "index": 1},
        "render": "page:index",
        "contains": [{"as": "Heading", "text": "Olá, Ada!"}, {"as": "Button", "props": {"label": "Another language"}}, {"as": "Input", "props": {"placeholder": "Your name"}}]
      },
      {
        "name": "cycling past the last greeting wraps around",
        "description": "Action scenario: transforms only, so no stubs are needed and the effect log must be empty.",
        "state": {"index": 4},
        "run": ["next-greeting", "next-greeting"],
        "after": {"state": {"index": 1}, "effects": [], "expect": {"greeting": "Olá"}}
      }
    ]
  }
}
