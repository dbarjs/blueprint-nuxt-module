{
  "name": "blueprint-nuxt-module",
  "version": "1.0.0",
  "description": "Turn every Blueprint document under content/ into a complete Nuxt application (Nuxt UI + Nuxt Content).",
  "repository": "eduardobarros/blueprint-nuxt-module",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./content": {
      "types": "./dist/content.d.mts",
      "import": "./dist/content.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "content": [
        "./dist/content.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "workspaces": [
    "playground"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "release": "npm run lint && npm run test:all && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run test/engine test/documents.test.ts",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "test:engine": "vitest run test/engine",
    "typecheck": "vue-tsc --noEmit",
    "test:e2e": "cross-env NODE_OPTIONS=--max-old-space-size=6144 vitest run test/e2e.test.ts",
    "test:all": "pnpm test && pnpm test:e2e"
  },
  "dependencies": {
    "@nuxt/content": "^3.16.0",
    "@nuxt/kit": "^4.5.2",
    "@nuxt/ui": "^4.11.1",
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.130",
    "@nuxt/devtools": "^3.4.2",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "^4.2.0",
    "@types/node": "latest",
    "changelogen": "^0.6.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.1",
    "nuxt": "^4.5.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "keywords": [
    "nuxt",
    "nuxt-module",
    "blueprint",
    "nuxt-ui",
    "nuxt-content",
    "server-driven-ui"
  ]
}
